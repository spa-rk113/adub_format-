{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spa-rk113/adub_format-/blob/main/schema/adub-v1.schema.json",
  "title": "ADUB project",
  "description": "Draft schema for the public ADUB anime dubbing project format.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "project",
    "speakers",
    "scenes",
    "events"
  ],
  "properties": {
    "format": {
      "const": "adub"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\."
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "duration_seconds",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "media_available"
          ],
          "properties": {
            "kind": {
              "enum": [
                "video",
                "audio",
                "unknown"
              ]
            },
            "uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "asset_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "media_available": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "frame_rate": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "speaker_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "speaker_type": {
            "enum": [
              "character",
              "narrator",
              "background_group",
              "unknown",
              "other"
            ]
          },
          "voice_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "visual_identity": {
            "type": [
              "object",
              "null"
            ]
          },
          "voice_profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string"
          },
          "visible_speaker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_observations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "event_type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "event_type": {
            "enum": [
              "speech",
              "sound_effect",
              "music",
              "ambience",
              "other"
            ]
          },
          "speech_kind": {
            "enum": [
              "dialogue",
              "narration",
              "inner_thought",
              "background_dialogue",
              "announcement",
              "singing",
              "uncertain",
              "other"
            ]
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "screen_presence": {
            "enum": [
              "on_screen",
              "off_screen",
              "voiceover",
              "not_applicable",
              "unknown"
            ]
          },
          "source_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "translation": {
            "type": [
              "object",
              "null"
            ]
          },
          "acting": {
            "type": [
              "object",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "object",
              "null"
            ]
          },
          "overlap_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_audio": {
            "type": [
              "string",
              "null"
            ]
          },
          "dub_audio": {
            "type": [
              "string",
              "null"
            ]
          },
          "word_timings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "track_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "needs_review",
              "confirmed",
              "rejected"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
